<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plain console program that checks the tic-tac-toe rules. No test framework, so no third-party packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/TicTacToe/Game/*.cs" Link="Game/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
